{
  "name": "web-mcp-assistant",
  "version": "0.1.13",
  "description": "用于部署和管理 Coding Tools MCP、OpenAI Tunnel 与 ChatGPT 接入的 Windows 设置管理器",
  "author": "3169657175",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naledao/gpt-webcodex.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "icon:build": "electron scripts/generate-icon.js",
    "runtime:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-native-runtime.ps1",
    "start": "electron .",
    "test": "node --test tests/*.test.js && node scripts/check-source-root-clean.js",
    "audit:prod": "npm audit --omit=dev",
    "manifest:annotate": "node scripts/annotate-update-manifest.js",
    "verify:release": "node scripts/verify-release.js",
    "dist": "npm run runtime:prepare && npm run icon:build && npm test && electron-builder --win nsis --publish never && npm run manifest:annotate",
    "release:win": "npm run dist && npm run verify:release",
    "dist:dir": "npm run icon:build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.gptwebcodex.assistant",
    "productName": "网页 MCP 助手",
    "artifactName": "web-mcp-assistant-setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "naledao",
      "repo": "gpt-webcodex",
      "releaseType": "draft"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "renderer/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "electron/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "网页 MCP 助手",
      "installerIcon": "electron/app-icon.ico",
      "uninstallerIcon": "electron/app-icon.ico",
      "installerHeaderIcon": "electron/app-icon.ico",
      "runAfterFinish": true
    }
  }
}
